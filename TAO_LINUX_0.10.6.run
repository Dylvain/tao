#!/usr/bin/env python3
# Tao local installer. Source archive is embedded, verified, and kept under ~/tao-linux-0.10.6.
import base64,hashlib,io,os,subprocess,sys,zipfile
from pathlib import Path
PAYLOAD=''
DIGEST='7d9948f0c65e836b6422a2399108fe1cc478dd3df10005cf3801b0f97d66a803'
DATA=base64.b64decode(PAYLOAD)
if hashlib.sha256(DATA).hexdigest()!=DIGEST: raise SystemExit("Archive corrompue")
root=Path.home()/"tao-linux-0.10.6"
os.environ["TAO_INIT_SOURCE_GIT"]="1" if not root.exists() else "0"
with zipfile.ZipFile(io.BytesIO(DATA)) as z:
    # Validate the entire archive and existing source before writing any file.
    records=[]
    for item in z.infolist():
        parts=Path(item.filename).parts
        if not parts or parts[0]!="tao-linux-0.10.6" or ".." in parts: raise SystemExit("Chemin d'archive invalide")
        rel=Path(*parts[1:]); out=root/rel
        if root.is_symlink() or not out.resolve().is_relative_to(root.resolve()): raise SystemExit("Lien de destination refusé")
        data=z.read(item)
        if out.exists() and (out.is_symlink() or not out.is_file() or out.read_bytes()!=data):
            raise SystemExit("Source déjà modifiée, préservée : "+str(out)+". Extraire le ZIP ailleurs pour une mise à jour.")
        records.append((out,data))
    for out,data in records:
        out.parent.mkdir(parents=True,exist_ok=True)
        if not out.exists(): out.write_bytes(data)
print("Sources :",root,flush=True)
raise SystemExit(subprocess.call([sys.executable,str(root/"bootstrap/install.py"),*sys.argv[1:]]))
